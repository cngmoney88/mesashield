<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyTitle>MesaShield Service</AssemblyTitle>
    <Product>MesaShield Security</Product>
    <Version>0.20.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- The always-on protection engine. Runs headless as a Windows Service (LocalSystem),
         before login, and restarts automatically if stopped. The desktop app is a viewer. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MesaShield.Core\MesaShield.Core.csproj" />
    <ProjectReference Include="..\MesaShield.Windows\MesaShield.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

</Project>
